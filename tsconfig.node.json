{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM"],
    "allowJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["next-env.d.ts", "**/*.config.{js,ts}"]
}